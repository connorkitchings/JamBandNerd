# JamBandNerd website server-side Supabase access
# Copy this file to apps/web/.env.local for local website development.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional public anon-key pair for client-side live prediction refreshes.
# These must mirror the server-side URL/anon key and must not use service-role keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin credentials for protected admin routes
ADMIN_PASSWORD=your_secure_password
ADMIN_SESSION_SECRET=your_random_32_char_secret
